{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cool Computers Guide",
  "colors": {
    "primary": "#548EFF",
    "light": "#6AA0FF",
    "dark": "#1D69FF"
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#F3F4F6",
      "dark": "#0E0F11"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/install"
        ]
      },
      {
        "group": "Your computer",
        "pages": [
          "computers/how-it-works",
          "computers/persistence"
        ]
      },
      {
        "group": "Use it",
        "pages": [
          "use/cli",
          "use/ssh",
          "use/email",
          "use/agents"
        ]
      },
      {
        "group": "Build with the API",
        "pages": [
          "api-reference/overview",
          "api-reference/authentication",
          "api-reference/errors"
        ]
      },
      {
        "group": "Endpoint reference",
        "openapi": "https://www.cool.computer/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cool Computers",
          "href": "https://www.cool.computer",
          "icon": "globe",
          "color": {
            "light": "#548EFF",
            "dark": "#6AA0FF"
          }
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://www.cool.computer/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://www.cool.computer/app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Use a persistent Linux computer with its own address and inbox."
}
