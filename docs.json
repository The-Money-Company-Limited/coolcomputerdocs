{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cool Computers",
  "colors": {
    "primary": "#155DFF",
    "light": "#6AA0FF",
    "dark": "#1D69FF"
  },
  "logo": {
    "light": "/logo-light.png",
    "dark": "/logo-dark.png"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#F3F4F6",
      "dark": "#0E0F11"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Connect your agent",
        "pages": [
          "agents/overview",
          "agents/claude-code",
          "agents/codex",
          "agents/cursor",
          "agents/pi",
          "agents/gemini",
          "agents/hermes",
          "agents/openclaw",
          "agents/claude",
          "agents/chatgpt",
          "agents/grok",
          "agents/other-mcp-clients",
          "agents/cli",
          "agents/ssh"
        ]
      },
      {
        "group": "Your computer",
        "pages": [
          "computers/how-it-works",
          "computers/persistence"
        ]
      },
      {
        "group": "Use it",
        "pages": [
          "use/cli",
          "use/email"
        ]
      },
      {
        "group": "Build with the API",
        "pages": [
          "api-reference/overview",
          "api-reference/authentication",
          "api-reference/errors"
        ]
      },
      {
        "group": "Endpoint reference",
        "openapi": "https://www.cool.computer/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cool Computers",
          "href": "https://www.cool.computer",
          "icon": "globe",
          "color": {
            "light": "#155DFF",
            "dark": "#6AA0FF"
          }
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/use/mcp",
      "destination": "/agents/overview"
    },
    {
      "source": "/use/agents",
      "destination": "/agents/overview"
    },
    {
      "source": "/use/ssh",
      "destination": "/agents/ssh"
    },
    {
      "source": "/getting-started/install",
      "destination": "/agents/cli"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://www.cool.computer/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://www.cool.computer/app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "description": "The official Cool Computers user and developer guide: connect your agent, the CLI, the HTTP API, authentication, and computers."
}
